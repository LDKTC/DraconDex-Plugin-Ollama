{
  "id": "ollama_chat",
  "name": "Ollama Chat",
  "version": "0.1.0",
  "entry": "index.html",
  "files": [
    "index.html",
    "panel.html",
    "app.js",
    "panel.js",
    "style.css",
    "src/store.js",
    "src/provider.js",
    "src/chat.js",
    "src/ui.js"
  ],
  "panels": [
    { "id": "chat", "title": "Ollama", "icon": "🦙", "entry": "panel.html" }
  ],
  "permissions": {
    "net": ["http://localhost:11434", "http://127.0.0.1:11434"],
    "context": ["module"]
  },
  "tables": [
    {
      "name": "session",
      "columns": [
        { "name": "title", "type": "TEXT" },
        { "name": "model", "type": "TEXT" },
        { "name": "system_prompt", "type": "TEXT" },
        { "name": "module_key", "type": "TEXT" },
        { "name": "create_at", "type": "TEXT" },
        { "name": "update_at", "type": "TEXT" }
      ]
    },
    {
      "name": "message",
      "columns": [
        { "name": "session_ref", "type": "INTEGER" },
        { "name": "role", "type": "TEXT" },
        { "name": "content", "type": "TEXT" },
        { "name": "create_at", "type": "TEXT" },
        { "name": "in_tokens", "type": "INTEGER" },
        { "name": "out_tokens", "type": "INTEGER" },
        { "name": "error", "type": "TEXT" }
      ]
    },
    {
      "name": "config",
      "columns": [
        { "name": "ckey", "type": "TEXT" },
        { "name": "cvalue", "type": "TEXT" }
      ]
    }
  ]
}
